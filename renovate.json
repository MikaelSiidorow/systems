{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "Europe/Helsinki",
  "semanticCommits": "enabled",
  "labels": ["dependencies"],
  "dependencyDashboard": true,
  "prHourlyLimit": 0,
  "enabledManagers": ["github-actions", "argocd", "kubernetes", "terraform", "custom.regex", "nix"],
  "argocd": {
    "managerFilePatterns": ["/^k8s/apps/.+\\.ya?ml$/"]
  },
  "kubernetes": {
    "managerFilePatterns": ["/^k8s/.+\\.ya?ml$/"]
  },
  "customManagers": [
    {
      "description": "CLIProxyAPI release binary and SHA-256 checksum",
      "customType": "regex",
      "managerFilePatterns": ["/^infra/nixos/hosts/hestia/cli-proxy-api\\.nix$/"],
      "matchStrings": [
        "release = \"(?<currentValue>v[0-9.]+)\";[\\s\\S]*?sha256 = \"(?<currentDigest>[a-f0-9]{64})\";"
      ],
      "depNameTemplate": "router-for-me/CLIProxyAPI",
      "datasourceTemplate": "github-release-attachments",
      "versioningTemplate": "semver"
    },
    {
      "description": "k3s HelmChart manifests embedded in the k8s-server NixOS config",
      "customType": "regex",
      "managerFilePatterns": ["/^infra/nixos/hosts/k8s-server/k3s\\.nix$/"],
      "matchStrings": [
        "chart: (?<depName>\\S+)\\s+repo: (?<registryUrl>\\S+)[\\s\\S]*?version: (?<currentValue>\\S+)"
      ],
      "datasourceTemplate": "helm"
    }
  ],
  "packageRules": [
    {
      "description": "Flake inputs are updated by update-flake-lock.yml",
      "matchFileNames": ["**/flake.nix", "**/flake.lock"],
      "enabled": false
    },
    {
      "description": "Update the T3 Code client and server revision pins together",
      "matchManagers": ["nix"],
      "matchDepNames": ["llm-agents"],
      "enabled": true,
      "groupName": "T3 Code",
      "automerge": false
    },
    {
      "description": "One weekly PR for action updates; auto-merge once CI Summary passes",
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions",
      "matchUpdateTypes": ["minor", "patch", "digest", "pinDigest"],
      "automerge": true
    },
    {
      "description": "Merging these workflows runs deploys, so review their updates",
      "matchManagers": ["github-actions"],
      "matchFileNames": [".github/workflows/deploy.yml", ".github/workflows/k8s-rollout.yml"],
      "automerge": false
    },
    {
      "description": "Regenerate the committed Traefik CRDs in the same PR; Helm never upgrades them",
      "matchManagers": ["custom.regex"],
      "matchDepNames": ["traefik"],
      "postUpgradeTasks": {
        "commands": ["bash .github/scripts/traefik-crds.sh {{{newVersion}}}"],
        "fileFilters": ["infra/nixos/hosts/k8s-server/traefik-crds.yaml"],
        "executionMode": "update",
        "installTools": { "helm": {} }
      }
    },
    {
      "description": "Cluster, infra and cloud changes deploy on merge; never auto-merge",
      "matchFileNames": ["infra/**", "k8s/**", "terraform/**"],
      "automerge": false
    },
    {
      "description": "Argo CD app minor/patch chart and image updates auto-merge after three days, so a broken or pulled release is caught upstream first; CI renders and schema-checks them, and the container health alerts catch the rest. Majors and 0.x stay manual",
      "matchFileNames": ["k8s/**"],
      "matchUpdateTypes": ["minor", "patch"],
      "matchCurrentVersion": "!/^v?0\\./",
      "minimumReleaseAge": "3 days",
      "automerge": true
    },
    {
      "description": "The monitoring stack reports on the other updates, so review its own",
      "matchFileNames": [
        "k8s/apps/alloy.yaml",
        "k8s/apps/kube-prometheus-stack.yaml",
        "k8s/apps/loki.yaml",
        "k8s/apps/tempo.yaml"
      ],
      "automerge": false
    }
  ],
  "nix": {
    "enabled": true
  }
}
